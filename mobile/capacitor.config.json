{
  "appId": "com.lumi.play",
  "appName": "Lumi",
  "webDir": "www",
  "backgroundColor": "#100609",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "PushNotifications": {"presentationOptions": ["alert", "sound", "badge"]},
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#100609",
      "overlaysWebView": false
    }
  }
}
