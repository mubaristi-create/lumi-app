{
  "name": "lumi-mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "sync": "npm run build:web && cap sync && node scripts/configure-native.mjs",
    "android:add": "npm run build:web && cap add android && node scripts/configure-native.mjs",
    "ios:add": "npm run build:web && cap add ios && node scripts/configure-native.mjs",
    "android:open": "cap open android",
    "ios:open": "cap open ios",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "ios:simulator": "bash scripts/build-ios-simulator.sh",
    "ios:release": "bash scripts/build-ios-release.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/status-bar": "^8.0.0",
    "@supabase/supabase-js": "^2.0.0",
    "@capacitor/push-notifications": "8.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0",
    "xcode": "3.0.1",
    "plist": "3.1.1"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
